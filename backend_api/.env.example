# Masidy Backend API - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Masidy API
APP_VERSION=1.0.0
DEBUG=false

# Database (for local development, use SQLite)
DATABASE_URL=sqlite+aiosqlite:///./masidy.db

# For production on Render, use PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/masidy

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (optional)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# Usage Tracking & Pricing
OPENAI_COST_PER_1K_TOKENS=0.0015
DOCKER_COST_PER_MINUTE=0.001
GITHUB_STORAGE_PER_REPO=0.10
PLATFORM_MARKUP_PERCENT=10.0

# CORS
CORS_ORIGINS=["http://localhost:3000","https://masidy.ai"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
