          "tool_name": "write_file",
          "tool_args": {
            "path": "api_service/app/api/routes.py",
            "content": "\"\"\"API Routes\"\"\"\n\nfrom fastapi import APIRouter, Depends, HTTPException\nfrom sqlalchemy.orm import Session\nfrom typing import List\n\nfrom app.core.database import get_db\nfrom app.crud.item import item_crud\nfrom app.schemas.item import Item, ItemCreate, ItemUpdate, ItemList\n\nrouter = APIRouter()\n\n\n@router.get(\"/items\", response_model=ItemList)\ndef list_items(skip: int = 0, limit: int = 100, db: Session = Depends(get_db)):\n    items = item_crud.get_all(db, skip=skip, limit=limit)\n    total = item_crud.count(db)\n    return {\"items\": items, \"total\": total}\n\n\n@router.post(\"/items\", response_model=Item, status_code=201)\ndef create_item(item: ItemCreate, db: Session = Depends(get_db)):\n    return item_crud.create(db, item)\n\n\n@router.get(\"/items/{id}\", response_model=Item)\ndef get_item(id: int, db: Session = Depends(get_db)):\n    db_obj = item_crud.get(db, id)\n    if not db_obj:\n        raise HTTPException(status_code=404, detail=\"Item not found\")\n    return db_obj\n\n\n@router.put(\"/items/{id}\", response_model=Item)\ndef update_item(id: int, item: ItemUpdate, db: Session = Depends(get_db)):\n    db_obj = item_crud.update(db, id, item)\n    if not db_obj:\n        raise HTTPException(status_code=404, detail=\"Item not found\")\n    return db_obj\n\n\n@router.delete(\"/items/{id}\")\ndef delete_item(id: int, db: Session = Depends(get_db)):\n    success = item_crud.delete(db, id)\n    if not success:\n        raise HTTPException(status_code=404, detail=\"Item not found\")\n    return {\"message\": \"Item deleted\"}\n"
